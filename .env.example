APP_NAME=NEELASTACK
ENVIRONMENT=development
SECRET_KEY=change-this-in-local-development
DATABASE_URL=postgresql+psycopg://neelastack:neelastack@localhost:5432/neelastack
REDIS_URL=redis://localhost:6379/0
MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant
PROVIDER_FALLBACKS=ollama,openai,groq
PROVIDER_TIMEOUT_SECONDS=120
PROVIDER_MAX_RETRIES=2
JWT_EXPIRE_MINUTES=720
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_USE_REDIS=true
CORS_ORIGINS=http://localhost:5173
MAX_REQUEST_BODY_BYTES=10485760
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=false
TRUST_PROXY_HEADERS=false
ALLOWED_HOSTS=*
STT_PROVIDER=local
TTS_PROVIDER=local
VOICE_FALLBACKS=local,openai,groq
VOICE_MAX_UPLOAD_BYTES=26214400
WHISPER_COMMAND=
WHISPER_MODEL=base
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
GROQ_STT_MODEL=whisper-large-v3-turbo
WORKER_POLL_SECONDS=1
WORKER_CONCURRENCY=1
WORKER_JOB_TIMEOUT_SECONDS=600
WORKER_MAX_ATTEMPTS=3
